# Copy privately to .env with mode 0600.
# PAYMENT_MODE=fixture or paypal-sandbox. The gate always uses the real sandbox.
PAYMENT_MODE=fixture
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PORT=4188
# MODEL_MODE=fixture or ollama. Ollama uses a pre-installed model on this machine.
MODEL_MODE=fixture
OLLAMA_MODEL=
# Optional alternative MODEL_MODE=lmstudio, with a 2048-token loaded context.
LMSTUDIO_MODEL=
LMSTUDIO_PORT=1234
OLLAMA_PORT=11434
